PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/wedplan?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret

# Stripe TEST MODE key (starts with sk_test_). Never expose this to the browser.
STRIPE_SECRET_KEY=sk_test_replace_with_your_real_test_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret

# Origin the checkout pages return to (local dev redirects use the request origin automatically)
CLIENT_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
